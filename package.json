{
  "name": "fanfare",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test -c playwright.local.config.ts",
    "test:py": "python3 -m unittest discover -s tests/python",
    "serve:local": "node scripts/serve-local.mjs",
    "package:local": "node scripts/package-local.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "prebuild": "node scripts/fetch-assets.mjs && node scripts/make-icons.mjs",
    "postinstall": "patch-package --error-on-fail",
    "docs:media": "node scripts/make-docs-media.mjs",
    "postbuild": "node scripts/build-manual.mjs && node scripts/build-sw.mjs"
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "preact": "^11.2.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "gifenc": "^1.0.3",
    "jsdom": "^31.0.1",
    "marked": "^18.2.0",
    "onnxruntime-web": "1.18.0",
    "patch-package": "8.0.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
