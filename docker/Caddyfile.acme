# Opt-in (FANFARE_HOST=your.domain and FANFARE_ACME=1): a public certificate from Let's Encrypt.
# The host must publish 80 -> 8080 and 443 -> 8443 and the domain must point at it.
# Contacts Let's Encrypt (that is the one outgoing connection; the app itself contacts nobody).
{
	admin off
	persist_config off
	http_port 8080
	https_port 8443
	log {
		level WARN
		exclude http.log.error
	}
}

import /etc/caddy/fanfare.caddy

{$FANFARE_HOST} {
	tls {
		# Pinned: only Let's Encrypt, no fallback issuer.
		ca https://acme-v02.api.letsencrypt.org/directory
	}
	import fanfare
}

# Health check for the container itself: plain HTTP on loopback, so the HTTP -> HTTPS redirect
# of the public site is never involved (published ports reach the container's other address).
http://127.0.0.1:8081 {
	import health
}
