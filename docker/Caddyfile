# Default: plain HTTP on port 8080 (compose publishes it on 127.0.0.1 only). No certificate,
# no certificate authority. See Caddyfile.https for the opt-in LAN setup.
{
	admin off
	persist_config off
	auto_https off
	log {
		level WARN
		# Error log lines carry the request (client address, User-Agent): never keep them (GDPR).
		exclude http.log.error
	}
}

import /etc/caddy/fanfare.caddy

:8080 {
	import fanfare
}

http://127.0.0.1:8081 {
	import health
}
