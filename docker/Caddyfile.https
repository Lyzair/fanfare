# Opt-in (FANFARE_HOST + FANFARE_ACCEPT_CA_RISK=1 + certificates in /certs): HTTPS on port 8443
# with a certificate from the name-constrained local CA made by `fanfare-local.py --issue-certs`
# (the same CA as `fanfare-local --lan --https`). Caddy creates no CA of its own. The plain HTTP
# site on 8080 stays. Chosen by docker/entrypoint.sh, which prints the risks and checks the files.
{
	admin off
	persist_config off
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	log {
		level WARN
		exclude http.log.error
	}
}

import /etc/caddy/fanfare.caddy

:8080 {
	import fanfare
}

http://127.0.0.1:8081 {
	import health
}

{$FANFARE_HOST}:8443 {
	tls /certs/server.crt /certs/server.key
	import fanfare
}
